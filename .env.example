# Copy this file to .env and add your OpenAI key to enable LLM-powered explanations.
#
# 1. Copy:  cp .env.example .env
# 2. Edit .env and set (get a key from https://platform.openai.com/api-keys):
#
#    OPENAI_API_KEY=sk-your-key-here
#
# 3. Run the app as usual (run_demo.py or run_web.py). The Explainable Coach
#    will call gpt-4o-mini to generate a short, friendly "why" for each recommendation.
#
# Leave OPENAI_API_KEY unset to use rule-based explanations (no API calls, no cost).
#
OPENAI_API_KEY=
